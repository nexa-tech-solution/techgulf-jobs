rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Public data. Only the server (Admin SDK) writes it.
    match /companies/{slug} {
      allow read: if true;
    }
    match /cities/{slug} {
      allow read: if true;
    }
    match /market/{docId} {
      allow read: if true;
    }
    match /posts/{slug} {
      allow read: if true;
    }
    match /content/{docId} {
      allow read: if true;
    }
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'active';
    }

    // Each person's private data
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /savedJobs/{jobId} {
        allow read, write: if isOwner(uid);
      }
      match /alerts/{alertId} {
        allow read, write: if isOwner(uid);
      }
    }

    // A person's shared salary. Stays private: only aggregates are published, by the server.
    match /salaryReports/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['role', 'city', 'amount', 'updatedAt'])
        && request.resource.data.role is string && request.resource.data.role.size() < 60
        && request.resource.data.city is string && request.resource.data.city.size() < 60
        && request.resource.data.amount is number && request.resource.data.amount > 0;
    }

    // Employers can read their own records. Only the server writes them.
    match /companyMembers/{id} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    match /jobSubmissions/{id} {
      allow read: if request.auth != null && resource.data.submittedBy == request.auth.uid;
    }
  }
}
